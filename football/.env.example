# Copia este fichero a .env y rellena tus claves. NUNCA subas .env al repo.

# football-data.org (https://www.football-data.org/) — fixtures/resultados.
FOOTBALL_DATA_API_KEY=

# API-Football (https://www.api-football.com/) — stats avanzadas / soporte.
API_FOOTBALL_KEY=

# The Odds API (https://the-odds-api.com/) — cuotas y submercados.
ODDS_API_KEY=

# IA (Gemini primero, Groq como fallback). Refresca solo partidos del día a
# las 00:00 y 10:00 Europe/Madrid. FORCE_AI=1 permite una pasada manual.
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
FORCE_AI=0

# Base de datos. Por defecto SQLite local; para Postgres usa p. ej.:
# DATABASE_URL=postgresql+psycopg://usuario:pass@host:5432/futbol
DATABASE_URL=

# Parámetros de negocio.
SEASON=2025
BANKROLL=1000
MIN_EDGE=0.03
KELLY_MULTIPLIER=0.25
